+  let port;
+  for (let i = 0; i < 150; i++) {
+    const activePort = path.join(profile, 'DevToolsActivePort');
+    if (fs.existsSync(activePort)) { port = Number(fs.readFileSync(activePort, 'utf8').split('\n')[0]); break; }
+    if (child.exitCode !== null) throw new Error(`Chrome exited: ${stderr}`);
